name: 'iKuuu｜总节点池＋每组独立选择节点'
desc: |-
  iKuuu 作为唯一节点来源并自动刷新。
  顶部保留一个总的「🔰 选择节点」节点池。
  每个业务分组只显示三个选项：该组「🔰 选择节点」、DIRECT、REJECT。
  每个业务组的「🔰 选择节点」都是独立策略组，并使用 include-all: true 引入全部 iKuuu 节点。
proxy-groups: #!replace
  - name: 🔰 选择节点
    type: select
    include-all: true
    filter: '^(?!DIRECT$|REJECT$).*$'
    proxies:
      - DIRECT
      - REJECT

  - name: 🚀 节点选择
    type: select
    proxies:
      - 🔰 选择节点
      - DIRECT
      - REJECT

  - name: ♻️ 自动选择
    type: url-test
    use:
      - iKuuu
    filter: '^(?!.*(?:免费|下载专用)).+$'
    url: https://cp.cloudflare.com/generate_204
    interval: 1800
    timeout: 5
    tolerance: 80
    lazy: true
    proxies:
      - DIRECT
      - REJECT

  - name: 🍎 Apple AI｜选择节点
    type: select
    include-all: true
    filter: '^(?!DIRECT$|REJECT$).*$'
    proxies:
      - DIRECT
      - REJECT
  - name: 🍎 Apple AI
    type: select
    proxies:
      - 🍎 Apple AI｜选择节点
      - DIRECT
      - REJECT

  - name: 🤖 国外 AI｜选择节点
    type: select
    include-all: true
    filter: '^(?!DIRECT$|REJECT$).*$'
    proxies:
      - DIRECT
      - REJECT
  - name: 🤖 国外 AI
