name: 'iKuuu｜全局节点池＋各分组独立选择'
desc: |-
  全局只有一个总的「🚀 选择节点」节点池。
  每个业务分组固定三个选项：选择节点、DIRECT、REJECT。
  每个业务组的「选择节点」都是独立 select，并通过 include-all: true 自动读取 iKuuu 订阅节点。
proxy-groups: #!replace
  - name: 🚀 选择节点
    type: select
    include-all: true
    filter: '^(?!DIRECT$|REJECT$).*$'

  - name: 🍎 Apple AI
    type: select
    proxies:
      - 🍎 Apple AI｜选择节点
      - DIRECT
      - REJECT
  - name: 🍎 Apple AI｜选择节点
    type: select
    include-all: true
    filter: '^(?!DIRECT$|REJECT$).*$'

  - name: 🤖 国外 AI
    type: select
    proxies:
      - 🤖 国外 AI｜选择节点
      - DIRECT
      - REJECT
  - name: 🤖 国外 AI｜选择节点
    type: select
    include-all: true
    filter: '^(?!DIRECT$|REJECT$).*$'

  - name: 🇬🇱 Google
    type: select
    proxies:
      - 🇬🇱 Google｜选择节点
      - DIRECT
      - REJECT
  - name: 🇬🇱 Google｜选择节点
