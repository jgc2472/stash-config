    proxies:
      - 🔰 选择节点
      - DIRECT
      - REJECT
  - name: Ⓜ️ Meta
    type: select
    include-all: true
    filter: '^(?!DIRECT$|REJECT$).*$'
    proxies:
      - 🔰 选择节点
      - DIRECT
      - REJECT
  - name: 🎵 TikTok
    type: select
    include-all: true
    filter: '^(?!DIRECT$|REJECT$).*$'
    proxies:
      - 🔰 选择节点
      - DIRECT
      - REJECT
  - name: 🎓学术网站
    type: select
    include-all: true
    filter: '^(?!DIRECT$|REJECT$).*$'
    proxies:
      - 🔰 选择节点
      - DIRECT
      - REJECT
  - name: 🇨🇳 国内网站
    type: select
    include-all: true
    filter: '^(?!DIRECT$|REJECT$).*$'
    proxies:
      - 🔰 选择节点
      - DIRECT
      - REJECT
  - name: 🌍 国外网站
    type: select
    include-all: true
    filter: '^(?!DIRECT$|REJECT$).*$'
    proxies:
      - 🔰 选择节点
      - DIRECT
      - REJECT
  - name: 🛑 拦截广告
    type: select
