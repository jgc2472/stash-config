name: 'iKuuu｜我的分组｜总节点＋每组独立节点选择'
desc: |-
  iKuuu 作为唯一节点来源；保留自动刷新。
  总节点组可直接选择全部 iKuuu 节点。
  每个业务组都有独立的“选择节点”子策略组、DIRECT、REJECT。
  点击业务组里的“选择节点”即可进入该业务组自己的全部 iKuuu 节点，互不影响。
proxy-groups: #!replace
  - name: 🚀 节点选择
    type: select
    include-all: true
    filter: '^(?!DIRECT$|REJECT$).*$'
    proxies:
      - DIRECT
      - REJECT
  - name: ♻️ 自动选择
    type: url-test
    use:
      - iKuuu
    filter: '^(?!.*(?:免费|下载专用)).+$'
    url: https://cp.cloudflare.com/generate_204
    interval: 1800
    timeout: 5
    tolerance: 80
    lazy: true
    proxies:
      - DIRECT
      - REJECT
  - name: 🍎 选择节点
    type: select
    include-all: true
    filter: '^(?!DIRECT$|REJECT$).*$'
    proxies:
      - DIRECT
      - REJECT
  - name: 🍎 Apple AI
    type: select
    proxies:
      - 🍎 选择节点
      - DIRECT
      - REJECT
  - name: 🤖 选择节点
    type: select
    include-all: true
    filter: '^(?!DIRECT$|REJECT$).*$'
    proxies:
      - DIRECT
      - REJECT
  - name: 🤖 国外 AI
    type: select
    proxies:
