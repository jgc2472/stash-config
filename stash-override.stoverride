name: 'iKuuu｜我的分组｜完整保留原组＋每组独立选节点'
desc: |-
  保留原 iKuuu 的节点选择与自动选择策略组。
  新增 🔰 选择节点，并让每个业务组独立调用当前 iKuuu 全部节点。
  不复制节点，不重新创建订阅，不接管 iKuuu 刷新。
proxy-groups: #!replace
  - name: 🚀 节点选择
    type: select
    include-all: true
    filter: '^(?!DIRECT$|REJECT$).*$'
    proxies:
      - DIRECT
      - REJECT
  - name: ♻️ 自动选择
    type: url-test
    use:
      - iKuuu
    filter: '^(?!.*(?:免费|下载专用)).+$'
    url: https://cp.cloudflare.com/generate_204
    interval: 1800
    timeout: 5
    tolerance: 80
    lazy: true
    proxies:
      - DIRECT
      - REJECT
  - name: 🔰 选择节点
    type: select
    include-all: true
    filter: '^(?!DIRECT$|REJECT$).*$'
    proxies:
      - DIRECT
      - REJECT
  - name: 🍎 Apple AI
    type: select
    include-all: true
    filter: '^(?!DIRECT$|REJECT$).*$'
    proxies:
      - 🔰 选择节点
      - DIRECT
      - REJECT
  - name: 🤖 国外 AI
    type: select
    include-all: true
    filter: '^(?!DIRECT$|REJECT$).*$'
    proxies:
      - 🔰 选择节点
      - DIRECT
      - REJECT
  - name: 🇬🇱 Google
    type: select
    include-all: true
    filter: '^(?!DIRECT$|REJECT$).*$'
    proxies:
      - 🔰 选择节点
      - DIRECT
      - REJECT
  - name: ☁️ OneDrive
    type: select
    include-all: true
    filter: '^(?!DIRECT$|REJECT$).*$'
